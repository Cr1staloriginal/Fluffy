# Required: create a Discord bot in the Developer Portal and keep the token private.
DISCORD_TOKEN=

# Core settings
OWNER_ID=
GUILD_ID=
DATABASE_PATH=data/database.db
LOG_LEVEL=INFO

# Server-local timezone (integer UTC offset, e.g. 3 for UTC+3)
TIMEZONE_OFFSET=3
SERVER_BIRTHDAY=30-10

# Automatic messages
AUTO_MESSAGE_ENABLED=true
AUTO_MESSAGE_CHANNEL_ID=
AUTO_MESSAGE_INTERVAL=60
AUTO_MESSAGE_MIN_DELAY=0
NIGHT_START_HOUR=23
NIGHT_END_HOUR=6

# Anti-raid: 5 channel deletions in 1 second trigger a response.
# false = log only; set true on the server to enable automatic kick of the identified offender.
# Requires View Audit Log + Kick Members and Fluffy's role above the offender.
ANTIRAID_AUTO_PUNISH=false

# Logging channels (leave blank/0 to disable a category)
LOG_CH_MEMBERS=0
LOG_CH_MESSAGES=0
LOG_CH_TICKETS=0
LOG_CH_VOICE=0
LOG_CH_MOD=0

# Welcome / verification (IDs are Discord snowflakes)
WELCOME_CHANNEL_ID=0
GENERAL_CHANNEL_ID=0
RULES_CHANNEL_ID=0
VERIFY_CHANNEL_ID=0
VERIFY_SUBMIT_CHANNEL_ID=0
VERIFIED_ROLE_ID=0
REJECTED_ROLE_ID=0
MODERATION_ROLE_ID=0
DEFAULT_ROLES=

# Copy this file to .env and fill in your own values. Never commit .env.

# Temporary voice rooms (optional; 0 disables the feature)
# Set TEMP_VOICE_LOBBY_ID to the voice lobby channel ID.
# TEMP_VOICE_CATEGORY_ID=0 uses the lobby's current category.
TEMP_VOICE_LOBBY_ID=0
TEMP_VOICE_CATEGORY_ID=0
TEMP_VOICE_PREFIX=🔊・

# External publication/live notifications (optional)
# Twitch Developer Console values; keep the app token private.
TWITCH_CLIENT_ID=
TWITCH_APP_TOKEN=
# VK community wall access token; keep private.
VK_ACCESS_TOKEN=
