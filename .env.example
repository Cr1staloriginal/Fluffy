# Required: create a Discord bot in the Developer Portal and keep the token private.
DISCORD_TOKEN=

# Fluffy is dedicated to one server only: set the numeric Discord server ID of Fluffy Town.
# Startup is refused when GUILD_ID is empty or zero.
OWNER_ID=
GUILD_ID=
DATABASE_PATH=data/database.db
LOG_LEVEL=INFO

# Server-local timezone (integer UTC offset, e.g. 3 for UTC+3)
TIMEZONE_OFFSET=3
SERVER_BIRTHDAY=30-10

# Automatic messages
AUTO_MESSAGE_ENABLED=true
AUTO_MESSAGE_CHANNEL_ID=
AUTO_MESSAGE_INTERVAL=60
AUTO_MESSAGE_MIN_DELAY=0
NIGHT_START_HOUR=23
NIGHT_END_HOUR=6

# Anti-raid: 5 channel deletions in 1 second trigger a response.
# Safe default: false = log only. Set true explicitly to enable automatic kick/timeout.
# Keep automatic punishment disabled until the audit-log lookup and role hierarchy have been checked safely on Fluffy Town. Requires View Audit Log + Kick Members.
ANTIRAID_AUTO_PUNISH=false
# Admins can also change this at runtime with /антирейд автонаказания; the override is persisted in SQLite.

# Logging channels (leave blank/0 to disable a category)
LOG_CH_MEMBERS=0
LOG_CH_MESSAGES=0
LOG_CH_TICKETS=0
LOG_CH_VOICE=0
LOG_CH_MOD=0

# AutoMod exemptions (comma- or semicolon-separated Discord IDs; optional)
# Existing built-in ignored channels remain ignored.
AUTOMOD_IGNORED_CHANNEL_IDS=
AUTOMOD_IGNORED_ROLE_IDS=

# Optional event-specific log destinations override the category above.
# Example keys used by the member/message audit cog:
# LOG_CH_MEMBERS_MEMBER_JOIN=0
# LOG_CH_MEMBERS_MEMBER_REMOVE=0
# LOG_CH_MEMBERS_MEMBER_ROLES=0
# LOG_CH_MESSAGES_MESSAGE_DELETE=0
# LOG_CH_MESSAGES_MESSAGE_EDIT=0
# LOG_CH_MOD_MEMBER_TIMEOUT_STATE=0

# Welcome / verification (IDs are Discord snowflakes)
VERIFY_SUBMISSION_COOLDOWN_SECONDS=60
WELCOME_CHANNEL_ID=0
GENERAL_CHANNEL_ID=0
RULES_CHANNEL_ID=0
VERIFY_CHANNEL_ID=0
VERIFY_SUBMIT_CHANNEL_ID=0
VERIFIED_ROLE_ID=0
REJECTED_ROLE_ID=0
MODERATION_ROLE_ID=0
DEFAULT_ROLES=

# Copy this file to .env and fill in your own values. Never commit .env.

# Temporary voice rooms (optional; 0 disables the feature)
# Set TEMP_VOICE_LOBBY_ID to the voice lobby channel ID.
# TEMP_VOICE_CATEGORY_ID=0 uses the lobby's current category.
TEMP_VOICE_LOBBY_ID=0
TEMP_VOICE_CATEGORY_ID=0
# Text channel for the persistent button panel; 0 disables the panel.
TEMP_VOICE_CONTROL_CHANNEL_ID=0
TEMP_VOICE_PREFIX=🔊・

# External publication/live notifications (optional)
# Twitch Developer Console values; keep the app token private.
TWITCH_CLIENT_ID=
TWITCH_APP_TOKEN=
# VK community wall access token; keep private.
VK_ACCESS_TOKEN=
